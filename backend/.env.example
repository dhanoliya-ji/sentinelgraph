# Copy this file to `.env` and fill in the values from your CognoDB Cloud console.
# `.env` is gitignored -- never commit real credentials.

# Connection URI shown in the CognoDB console, e.g.
# bolt+s://abc123.databases.cognodb.cloud
COGNODB_URI=

# Default user created with every CognoDB instance
COGNODB_USER=cognodb

# Generated password -- shown exactly ONCE at instance creation
COGNODB_PASSWORD=

# HTTP port for the FastAPI server
PORT=8000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Driver / query tuning. The free c0 instance is small (0.5 vCPU, 256 MB RAM,
# 200 connections) -- keep the pool modest.
MAX_CONNECTION_POOL_SIZE=15
QUERY_TIMEOUT_SECONDS=15
